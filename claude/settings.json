{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NEW_INIT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(npm ls:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(obsidian append:*)",
      "Bash(obsidian create:*)",
      "Bash(obsidian search:*)",
      "Bash(obsidian read:*)",
      "Bash(obsidian help)",
      "Bash(obsidian --help)",
      "Bash(agent-browser:*)",
      "Edit(**/*.{vue,ts})",
      "Read(**/*.{vue,ts})",
      "Read(~/.agent-browser/tmp/screenshots/screenshot-*.png)",
      "Read(~/.claude/agents/**)",
      "Read(~/.claude/references/**)",
      "Read(~/.claude/rules/**)",
      "Read(~/.claude/skills/**)",
      "Bash(obsidian search:context *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud run revisions list *)",
      "mcp__pms__describe_table",
      "mcp__claude_ai_Slack__slack_read_thread"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Bash(curl:*)",
      "Edit(/etc/**)"
    ],
    "ask": [
      "Bash(gh pr review:*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false
  },
  "language": "japanese",
  "effortLevel": "xhigh",
  "plansDirectory": "./plans",
  "autoMemoryEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(gcloud secrets delete:*) — protect Secret Manager entries from deletion given gcloud secrets usage in this project"
    ],
    "environment": []
  },
  "voiceEnabled": true
}
