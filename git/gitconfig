[includeIf "gitdir:~/workspaces/github.com/"]
    path = ~/.gitconfig_company
[includeIf "gitdir:~/workspaces/github.com/ssakihara/"]
    path = ~/.gitconfig_private
[includeIf "gitdir:~/workspaces/github-private/"]
    path = ~/.gitconfig_private
[user]
    useConfigOnly = true
[push]
    default = current
    autoSetupRemote = true
[core]
    precomposeunicode = true
    quotepath = false
    editor = vim
    pager = delta
    excludesfile = ~/.gitignore_global
[merge]
    ff = false
    conflictstyle = zdiff3
[diff]
    colorMoved = default
    algorithm = histogram
[fetch]
    prune = true
[pull]
    ff = only
[init]
    defaultBranch = main
[alias]
    st = status
    sw = switch
    b = branch
    cm = commit -m
    p = pull
    w = worktree
[delta]
    plus-style = "syntax #012800"
    minus-style = "syntax #340001"
    syntax-theme = Monokai Extended
    navigate = true
    side-by-side = true
[interactive]
    diffFilter = delta --color-only
[ghq]
    root = ~/workspaces
